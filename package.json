{
  "name": "losresis-react-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "xcrun simctl shutdown all 2>/dev/null; xcrun simctl boot \"iPhone 16\"; open -a Simulator; expo start --ios",
    "ios-ipad": "expo start --ios --device",
    "ios-ipad-13": "xcrun simctl boot \"iPad Pro 13-inch (M4)\" 2>/dev/null; open -a Simulator; expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "export:static-catalog": "node scripts/export_static_catalog.mjs",
    "scrape:cto-grades-2026": "node scripts/scrape_cto_grades_2026.mjs",
    "sync:cache-aliases": "node scripts/sync_storage_cache_aliases.mjs",
    "weekly-courses-bot:local": "RUN_LOCAL=1 deno run --allow-net --allow-env --env-file=supabase/functions/weekly-courses-bot/.env.local supabase/functions/weekly-courses-bot/index.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.8.11",
    "@react-navigation/native": "^7.1.24",
    "@react-navigation/native-stack": "^7.8.5",
    "@supabase/supabase-js": "^2.86.2",
    "country-state-city": "^3.2.1",
    "expo": "~54.0.28",
    "expo-application": "~7.0.8",
    "expo-auth-session": "^7.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-image-picker": "~17.0.10",
    "expo-local-authentication": "^17.0.8",
    "expo-localization": "~17.0.8",
    "expo-notifications": "~0.32.16",
    "expo-print": "~15.0.8",
    "expo-secure-store": "^15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "^15.0.10",
    "phosphor-react-native": "^3.0.6",
    "posthog-react-native": "^4.36.1",
    "posthog-react-native-session-replay": "1.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1313.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "^54.0.8",
    "typescript": "~5.9.2"
  }
